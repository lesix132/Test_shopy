<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Must match the main app so both share the same App Group container. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.jobtrack.shared</string>
    </array>

    <!-- Same Keychain group as the app (not strictly required by the current
         extension, which only queues text, but kept aligned for future use). -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.jobtrack.shared</string>
    </array>
</dict>
</plist>
